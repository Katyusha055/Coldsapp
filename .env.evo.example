# Desde aqui son variables de evolution api
# Habilitar el uso de la base de datos
DATABASE_ENABLED=true

# Elegir el proveedor de base de datos: postgresql o mysql
DATABASE_PROVIDER=postgresql

# URI de conexión con la base de datos
DATABASE_CONNECTION_URI=
# Nombre del cliente para la conexión de la base de datos
DATABASE_CONNECTION_CLIENT_NAME=evolution_exchange

# Elija los datos que desea guardar en la base de datos de la aplicación
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_DATA_HISTORIC=true

# Habilitar la caché Redis
CACHE_REDIS_ENABLED=true

# URI de conexión con Redis
CACHE_REDIS_URI=

# Prefijo para diferenciar los datos de diferentes instalaciones que utilizan el mismo Redis
CACHE_REDIS_PREFIX_KEY=evolution

# Habilitar para guardar la información de conexión en Redis en lugar de la base de datos
CACHE_REDIS_SAVE_INSTANCES=false

# Habilitar la caché local
CACHE_LOCAL_ENABLED=false

AUTHENTICATION_API_KEY=

CONFIG_SESSION_PHONE_VERSION=2.3000.1042168942
